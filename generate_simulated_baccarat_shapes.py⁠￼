"""Generate the compact 2-million-transition shape database (schema v3).

Default output: pattern_10m.sqlite3
The historical filename is retained for deployment compatibility, but metadata
clearly records 2,000,000 simulated targets.

This generator stores continue/switch/tie as the immediate next result.
"""

from __future__ import annotations

import argparse
import json
import random
import time
from collections import Counter
from pathlib import Path
from typing import Dict, List, Optional, Sequence, Tuple

from pattern_database_shape import initialize_database

B_PROB, P_PROB, T_PROB = 0.4586, 0.4462, 0.0952
DEFAULT_TRANSITIONS = 2_000_000
DEFAULT_MAX_ORDER = 16
DEFAULT_WEIGHTS: Dict[str, float] = {
    "random": 0.64,
    "dragon": 0.05,
    "chop": 0.09,
    "double_chop": 0.06,
    "one_two": 0.055,
    "two_one": 0.055,
    "cluster": 0.05,
}


def _table(weights: Dict[str, float]) -> List[Tuple[str, float]]:
    total = sum(max(0.0, v) for v in weights.values()) or 1.0
    out, acc = [], 0.0
    for name, weight in weights.items():
        acc += max(0.0, weight) / total
        out.append((name, acc))
    out[-1] = (out[-1][0], 1.0)
    return out


def _pick(rng: random.Random, table: Sequence[Tuple[str, float]]) -> str:
    x = rng.random()
    for name, limit in table:
        if x <= limit:
            return name
    return table[-1][0]


def _random_bp(rng: random.Random) -> str:
    return "B" if rng.random() < B_PROB / (B_PROB + P_PROB) else "P"


def _other(side: str) -> str:
    return "P" if side == "B" else "B"


def _segment(rng: random.Random, regime: str, n: int, start: Optional[str]) -> List[str]:
    side = start if start in {"B", "P"} and rng.random() < 0.5 else _random_bp(rng)
    out: List[str] = []
    if regime == "random":
        return [_random_bp(rng) for _ in range(n)]
    if regime == "chop":
        for _ in range(n):
            out.append(side)
            side = _other(side)
        return out
    if regime == "double_chop":
        while len(out) < n:
            out += [side] * min(2, n - len(out))
            side = _other(side)
        return out
    if regime in {"one_two", "two_one"}:
        rhythm = [1, 2] if regime == "one_two" else [2, 1]
        i = 0
        while len(out) < n:
            run = rhythm[i % 2]
            out += [side] * min(run, n - len(out))
            side = _other(side)
            i += 1
        return out
    if regime == "dragon":
        dominant = side
        while len(out) < n:
            run = rng.choices([3, 4, 5, 6, 7], [18, 27, 26, 18, 11], k=1)[0]
            out += [dominant] * min(run, n - len(out))
            if len(out) < n:
                out += [_other(dominant)] * min(rng.choice([1, 1, 2]), n - len(out))
        return out
    while len(out) < n:
        run = rng.choices([1, 2, 3, 4], [28, 34, 25, 13], k=1)[0]
        out += [side] * min(run, n - len(out))
        side = _other(side)
    return out


def generate_shoe(rng: random.Random, min_hands: int, max_hands: int) -> List[str]:
    target = rng.randint(min_hands, max_hands)
    table = _table(DEFAULT_WEIGHTS)
    shoe: List[str] = []
    last: Optional[str] = None
    while len(shoe) < target:
        regime = _pick(rng, table)
        length = min(target - len(shoe), rng.randint(6, 20))
        for bp in _segment(rng, regime, length, last):
            value = "T" if rng.random() < T_PROB else bp
            shoe.append(value)
            if value in {"B", "P"}:
                last = value
    return shoe[:target]


def _flush(conn, batch: Dict[str, List[int]]) -> None:
    if not batch:
        return
    conn.executemany(
        """
        INSERT INTO patterns(context,continue_count,switch_count,tie_count)
        VALUES(?,?,?,?)
        ON CONFLICT(context) DO UPDATE SET
          continue_count=continue_count+excluded.continue_count,
          switch_count=switch_count+excluded.switch_count,
          tie_count=tie_count+excluded.tie_count
        """,
        ((k, v[0], v[1], v[2]) for k, v in batch.items()),
    )
    batch.clear()
    conn.commit()


def build(db: str, target: int, max_order: int, seed: int) -> Dict[str, object]:
    path = Path(db)
    if path.exists():
        path.unlink()
    conn = initialize_database(str(path), replace_legacy=True)
    rng = random.Random(seed)
    batch: Dict[str, List[int]] = {}
    observations = shoes = 0
    outcomes: Counter[str] = Counter()
    started = time.time()

    while observations < target:
        shoe = generate_shoe(rng, 55, 85)
        shoes += 1
        outcomes.update(shoe)
        previous_bp: Optional[str] = None
        shape = ""

        for result in shoe:
            if observations >= target:
                break

            # Record every immediate next result, including tie.
            max_here = min(max_order, len(shape))
            if previous_bp is not None:
                for order in range(max_here + 1):
                    context = "" if order == 0 else shape[-order:]
                    counts = batch.setdefault(context, [0, 0, 0])
                    if result == "T":
                        counts[2] += 1
                    elif result == previous_bp:
                        counts[0] += 1
                    else:
                        counts[1] += 1
                observations += 1

            if result == "T":
                if previous_bp is not None:
                    shape += "T"
            else:
                if previous_bp is not None:
                    shape += "S" if result == previous_bp else "C"
                previous_bp = result

        if shoes % 800 == 0 or len(batch) >= 150_000:
            _flush(conn, batch)

    _flush(conn, batch)
    metadata = {
        "schema": "shape_continue_switch_tie_v3",
        "source_type": "synthetic_compact_2m",
        "observations": str(observations),
        "max_order": str(max_order),
        "seed": str(seed),
        "filename_compatibility_note": "pattern_10m.sqlite3 contains 2m observations",
    }
    conn.executemany(
        "INSERT OR REPLACE INTO metadata(key,value) VALUES(?,?)",
        metadata.items(),
    )
    conn.commit()
    conn.execute("PRAGMA wal_checkpoint(TRUNCATE)")
    conn.execute("VACUUM")
    conn.commit()
    contexts = int(conn.execute("SELECT COUNT(*) FROM patterns").fetchone()[0])
    conn.close()
    return {
        "ok": True,
        "db": str(path.resolve()),
        "observations": observations,
        "contexts": contexts,
        "outcomes": dict(outcomes),
        "size_mb": round(path.stat().st_size / 1024 / 1024, 2),
        "elapsed_seconds": round(time.time() - started, 2),
    }


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--db", default="pattern_10m.sqlite3")
    parser.add_argument("--transitions", type=int, default=DEFAULT_TRANSITIONS)
    parser.add_argument("--max-order", type=int, default=DEFAULT_MAX_ORDER)
    parser.add_argument("--seed", type=int, default=20260713)
    args = parser.parse_args()
    print(json.dumps(build(args.db, args.transitions, args.max_order, args.seed), ensure_ascii=False, indent=2))


if __name__ == "__main__":
    main()
