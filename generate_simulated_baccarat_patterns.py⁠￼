"""Generate a simulated baccarat pattern database.

This file creates synthetic B/P/T shoe histories and aggregates their
next-B/P suffix counts directly into the SQLite schema used by
``pattern_database.py``.

Important:
- ``--transitions 10000000`` means ten million simulated B/P training targets,
  not ten million unique contexts and not ten million real casino shoes.
- The generator mixes descriptive road shapes such as dragon/streak, chop,
  double-chop, 1-2 and 2-1 rhythms with a probability-calibrated random regime.
- Synthetic data is useful for cold-start/testing, but it is not a substitute
  for real historical shoe data and cannot create a guaranteed predictive edge.

Required companion file:
    pattern_database.py

Example:
    python generate_simulated_pattern_db.py \
        --db pattern_10m.sqlite3 \
        --transitions 10000000 \
        --max-order 24 \
        --seed 20260713

Quick test:
    python generate_simulated_pattern_db.py \
        --db pattern_test.sqlite3 \
        --transitions 100000 \
        --max-order 16
"""

from __future__ import annotations

import argparse
import json
import math
import random
import sqlite3
import time
from collections import Counter
from pathlib import Path
from typing import Dict, Iterable, List, Sequence, Tuple

from pattern_database import initialize_database

B_PROB = 0.4586
P_PROB = 0.4462
T_PROB = 0.0952

# Descriptive simulation mixture. These are generator weights, not claims that
# real baccarat shoes follow these percentages.
DEFAULT_REGIME_WEIGHTS: Dict[str, float] = {
    "random": 0.42,
    "dragon": 0.14,
    "chop": 0.13,
    "double_chop": 0.10,
    "one_two": 0.08,
    "two_one": 0.08,
    "cluster": 0.05,
}


def _normalize_weights(weights: Dict[str, float]) -> List[Tuple[str, float]]:
    cleaned = {k: max(0.0, float(v)) for k, v in weights.items()}
    total = sum(cleaned.values())
    if total <= 0:
        cleaned = {"random": 1.0}
        total = 1.0
    cumulative = 0.0
    result: List[Tuple[str, float]] = []
    for name, weight in cleaned.items():
        cumulative += weight / total
        result.append((name, cumulative))
    result[-1] = (result[-1][0], 1.0)
    return result


def _weighted_choice(rng: random.Random, cumulative: Sequence[Tuple[str, float]]) -> str:
    value = rng.random()
    for name, limit in cumulative:
        if value <= limit:
            return name
    return cumulative[-1][0]


def _bp_random(rng: random.Random) -> str:
    # Conditional B/P distribution after excluding ties.
    b_conditional = B_PROB / (B_PROB + P_PROB)
    return "B" if rng.random() < b_conditional else "P"


def _maybe_tie(rng: random.Random, bp_value: str) -> str:
    return "T" if rng.random() < T_PROB else bp_value


def _opposite(side: str) -> str:
    return "P" if side == "B" else "B"


def _build_bp_segment(
    rng: random.Random,
    regime: str,
    length: int,
    prior_side: str | None,
) -> List[str]:
    length = max(1, int(length))
    start = prior_side if prior_side in {"B", "P"} and rng.random() < 0.55 else _bp_random(rng)
    output: List[str] = []

    if regime == "random":
        for _ in range(length):
            output.append(_bp_random(rng))
        return output

    if regime == "dragon":
        side = start
        while len(output) < length:
            run = max(3, min(length - len(output), int(rng.expovariate(1 / 5.0)) + 3))
            output.extend([side] * run)
            side = _opposite(side)
            # Most dragon segments are dominated by one long run, with a small
            # chance of a short opposite connector.
            if len(output) < length and rng.random() < 0.55:
                output.extend([side] * min(length - len(output), rng.choice([1, 1, 2])))
                side = _opposite(side)
        return output[:length]

    if regime == "chop":
        side = start
        for _ in range(length):
            output.append(side)
            side = _opposite(side)
        return output

    if regime == "double_chop":
        side = start
        while len(output) < length:
            output.extend([side] * min(2, length - len(output)))
            side = _opposite(side)
        return output

    if regime in {"one_two", "two_one"}:
        side = start
        pattern = [1, 2] if regime == "one_two" else [2, 1]
        index = 0
        while len(output) < length:
            run = pattern[index % 2]
            output.extend([side] * min(run, length - len(output)))
            side = _opposite(side)
            index += 1
        return output

    # Cluster: mostly 2–4 hand blocks with occasional singletons.
    side = start
    while len(output) < length:
        run = rng.choices([1, 2, 3, 4, 5], weights=[12, 30, 28, 20, 10], k=1)[0]
        output.extend([side] * min(run, length - len(output)))
        side = _opposite(side)
    return output


def generate_shoe(
    rng: random.Random,
    min_hands: int,
    max_hands: int,
    regime_weights: Dict[str, float],
    regime_min_len: int,
    regime_max_len: int,
) -> List[str]:
    target_len = rng.randint(min_hands, max_hands)
    cumulative = _normalize_weights(regime_weights)
    shoe: List[str] = []
    last_bp: str | None = None

    while len(shoe) < target_len:
        regime = _weighted_choice(rng, cumulative)
        segment_len = min(
            target_len - len(shoe),
            rng.randint(regime_min_len, regime_max_len),
        )
        bp_segment = _build_bp_segment(rng, regime, segment_len, last_bp)
        for bp_value in bp_segment:
            outcome = _maybe_tie(rng, bp_value)
            shoe.append(outcome)
            if outcome in {"B", "P"}:
                last_bp = outcome

    return shoe[:target_len]


def _flush_batch(
    conn: sqlite3.Connection,
    batch: Dict[str, List[int]],
) -> int:
    if not batch:
        return 0
    conn.executemany(
        """
        INSERT INTO patterns(context,b_count,p_count)
        VALUES(?,?,?)
        ON CONFLICT(context) DO UPDATE SET
            b_count=b_count+excluded.b_count,
            p_count=p_count+excluded.p_count
        """,
        ((context, counts[0], counts[1]) for context, counts in batch.items()),
    )
    count = len(batch)
    batch.clear()
    conn.commit()
    return count


def build_simulated_database(
    db_path: str,
    target_transitions: int = 10_000_000,
    max_order: int = 24,
    seed: int = 20260713,
    min_hands: int = 55,
    max_hands: int = 85,
    commit_every_shoes: int = 1000,
    max_batch_contexts: int = 250_000,
    regime_min_len: int = 6,
    regime_max_len: int = 24,
    regime_weights: Dict[str, float] | None = None,
    replace_existing: bool = True,
) -> Dict[str, object]:
    target_transitions = max(1, int(target_transitions))
    max_order = max(1, int(max_order))
    min_hands = max(2, int(min_hands))
    max_hands = max(min_hands, int(max_hands))
    regime_weights = dict(regime_weights or DEFAULT_REGIME_WEIGHTS)

    db = Path(db_path)
    db.parent.mkdir(parents=True, exist_ok=True)
    if replace_existing and db.exists():
        db.unlink()

    conn = initialize_database(str(db))
    rng = random.Random(seed)
    batch: Dict[str, List[int]] = {}
    shoes = 0
    bp_transitions = 0
    total_hands = 0
    outcome_counts: Counter[str] = Counter()
    contexts_flushed = 0
    started = time.time()

    while bp_transitions < target_transitions:
        shoe = generate_shoe(
            rng=rng,
            min_hands=min_hands,
            max_hands=max_hands,
            regime_weights=regime_weights,
            regime_min_len=regime_min_len,
            regime_max_len=regime_max_len,
        )
        shoes += 1
        total_hands += len(shoe)
        outcome_counts.update(shoe)

        for target_index, target in enumerate(shoe):
            if target not in {"B", "P"}:
                continue
            if bp_transitions >= target_transitions:
                break
            bp_transitions += 1
            max_here = min(max_order, target_index)
            for order in range(max_here + 1):
                context = "" if order == 0 else "".join(
                    shoe[target_index - order : target_index]
                )
                counts = batch.setdefault(context, [0, 0])
                counts[0 if target == "B" else 1] += 1

        if (
            shoes % max(1, commit_every_shoes) == 0
            or len(batch) >= max_batch_contexts
        ):
            contexts_flushed += _flush_batch(conn, batch)

    contexts_flushed += _flush_batch(conn, batch)

    elapsed = time.time() - started
    metadata = {
        "source_type": "synthetic_mixed_regimes",
        "source_shoes": str(shoes),
        "transitions": str(bp_transitions),
        "total_hands": str(total_hands),
        "max_order": str(max_order),
        "seed": str(seed),
        "generator_version": "1.0",
        "regime_weights": json.dumps(regime_weights, ensure_ascii=False, sort_keys=True),
        "nominal_probabilities": json.dumps(
            {"B": B_PROB, "P": P_PROB, "T": T_PROB},
            sort_keys=True,
        ),
        "warning": (
            "Synthetic cold-start/testing data; not real casino history and "
            "not evidence of a predictive edge."
        ),
    }
    conn.executemany(
        "INSERT OR REPLACE INTO metadata(key,value) VALUES(?,?)",
        metadata.items(),
    )
    conn.commit()
    context_count = int(conn.execute("SELECT COUNT(*) FROM patterns").fetchone()[0])
    root = conn.execute(
        "SELECT b_count,p_count FROM patterns WHERE context=''"
    ).fetchone()
    conn.close()

    return {
        "ok": True,
        "db_path": str(db.resolve()),
        "source_type": "synthetic_mixed_regimes",
        "shoes": shoes,
        "total_hands": total_hands,
        "bp_transitions": bp_transitions,
        "contexts": context_count,
        "contexts_flushed": contexts_flushed,
        "root_counts": {
            "B": int(root[0]) if root else 0,
            "P": int(root[1]) if root else 0,
        },
        "outcome_counts": dict(outcome_counts),
        "max_order": max_order,
        "seed": seed,
        "elapsed_seconds": round(elapsed, 3),
        "regime_weights": regime_weights,
    }


def _parse_regime_weights(raw: str | None) -> Dict[str, float]:
    if not raw:
        return dict(DEFAULT_REGIME_WEIGHTS)
    result = dict(DEFAULT_REGIME_WEIGHTS)
    for part in raw.split(","):
        if "=" not in part:
            continue
        name, value = part.split("=", 1)
        name = name.strip()
        if name not in result:
            continue
        try:
            result[name] = max(0.0, float(value.strip()))
        except ValueError:
            continue
    return result


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Generate a simulated baccarat pattern SQLite database"
    )
    parser.add_argument("--db", default="pattern_10m.sqlite3")
    parser.add_argument("--transitions", type=int, default=10_000_000)
    parser.add_argument("--max-order", type=int, default=24)
    parser.add_argument("--seed", type=int, default=20260713)
    parser.add_argument("--min-hands", type=int, default=55)
    parser.add_argument("--max-hands", type=int, default=85)
    parser.add_argument("--commit-every-shoes", type=int, default=1000)
    parser.add_argument("--max-batch-contexts", type=int, default=250_000)
    parser.add_argument("--regime-min-len", type=int, default=6)
    parser.add_argument("--regime-max-len", type=int, default=24)
    parser.add_argument(
        "--regime-weights",
        default="",
        help=(
            "Comma-separated generator weights, e.g. "
            "random=0.42,dragon=0.14,chop=0.13,double_chop=0.10,"
            "one_two=0.08,two_one=0.08,cluster=0.05"
        ),
    )
    parser.add_argument(
        "--append",
        action="store_true",
        help="Append counts to an existing DB instead of replacing it",
    )
    args = parser.parse_args()

    result = build_simulated_database(
        db_path=args.db,
        target_transitions=args.transitions,
        max_order=args.max_order,
        seed=args.seed,
        min_hands=args.min_hands,
        max_hands=args.max_hands,
        commit_every_shoes=args.commit_every_shoes,
        max_batch_contexts=args.max_batch_contexts,
        regime_min_len=args.regime_min_len,
        regime_max_len=args.regime_max_len,
        regime_weights=_parse_regime_weights(args.regime_weights),
        replace_existing=not args.append,
    )
    print(json.dumps(result, ensure_ascii=False, indent=2))


if __name__ == "__main__":
    main()
